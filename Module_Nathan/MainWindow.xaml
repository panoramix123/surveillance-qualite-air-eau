<Window x:Class="Wpf_localiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="SafeBreath" Height="750" Width="1100" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="./#Dosis">

    <Border CornerRadius="12" Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#E0E0E0" CornerRadius="12,12,0,0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">

                        <Button Click="cmdAccueil_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,30,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="logo.png" Width="30" Height="30" Margin="0,0,10,0" />
                                <TextBlock Text="SafeBreath" FontSize="18" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="cmdNavCartes" Content="Cartes" Click="cmdNavigation_Click" Background="Transparent" BorderThickness="0" Foreground="Black" Margin="8,0" Cursor="Hand"/>
                        <Button x:Name="cmdNavMesures" Content="Mesures" Click="cmdNavigation_Click" Background="Transparent" BorderThickness="0" Foreground="Black" Margin="8,0" Cursor="Hand"/>
                        <Button x:Name="cmdNavAbonnes" Content="Abonnés" Click="cmdNavigation_Click" Background="Transparent" BorderThickness="0" Foreground="Black" Margin="8,0" Cursor="Hand"/>
                        <Button x:Name="cmdNavAlertes" Content="Alerter" Click="cmdNavigation_Click" Background="Transparent" BorderThickness="0" Foreground="Black" Margin="8,0" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="—" Click="cmdMinimize_Click" Background="Transparent" BorderThickness="0" Foreground="#333333" Width="25" Height="25" Cursor="Hand"/>
                        <Button x:Name="cmdMaximize" Content="▢" Click="cmdMaximize_Click" Background="Transparent" BorderThickness="0" Foreground="#333333" Width="25" Height="25" Cursor="Hand" Margin="2,0"/>
                        <Button Content="✕" Click="cmdClose_Click" Background="Transparent" BorderThickness="0" Foreground="#333333" Width="25" Height="25" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="panMesures" Visibility="Collapsed">
                    <TextBlock Text="Mesures dans l'air" FontSize="26" FontWeight="Bold" Foreground="White" Margin="35,25,30,10"/>
                    <UniformGrid Columns="2" Margin="25,70,25,25">
                        <Border Background="#F9F9F9" CornerRadius="12" Margin="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="PM2.5" FontWeight="Bold" FontSize="17" Foreground="#000000"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#444444" FontSize="14" LineHeight="18">Particules fines &lt; 2,5 µm. Elles pénètrent profondément dans les poumons.</TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#F9F9F9" CornerRadius="12" Margin="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="PM10" FontWeight="Bold" FontSize="17" Foreground="#000000"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#444444" FontSize="14" LineHeight="18">Particules en suspension &lt; 10 µm. Elles irritent les voies supérieures.</TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#F9F9F9" CornerRadius="12" Margin="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Ozone (O₃)" FontWeight="Bold" FontSize="17" Foreground="#000000"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#444444" FontSize="14" LineHeight="18">Gaz irritant photochimique. Hautement toxique pour le système respiratoire.</TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#F9F9F9" CornerRadius="12" Margin="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Dioxyde d'azote (NO₂)" FontWeight="Bold" FontSize="17" Foreground="#000000"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#444444" FontSize="14" LineHeight="18">Gaz issu de la combustion automobile. Il altère la fonction pulmonaire.</TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <Grid x:Name="panCartes" Visibility="Collapsed" Margin="15">
                    <Border Background="White" CornerRadius="10" Padding="3">
                        <Grid>
                            <gmap:GMapControl x:Name="mGMap"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20">
                                <Border Background="White" CornerRadius="20" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtRechercheVille" Width="200" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Background="Transparent" KeyDown="txtRechercheVille_KeyDown"/>
                                        <Button Content="🔍" Click="cmdRechercherVille_Click" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Margin="5,0,0,0"/>
                                        <Button Content="Lieux célèbres" Click="cmdLieuxCelebres_Click" Background="#4285F4" Foreground="White" BorderThickness="0" Padding="10,5" Margin="15,0,0,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="panAbonnes" Visibility="Collapsed" Margin="25">
                    <StackPanel>
                        <TextBlock Text="Gestion des abonnés" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <DataGrid x:Name="dgAbonnes" Height="300" AutoGenerateColumns="True" CanUserAddRows="False" Background="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20">
                            <TextBox x:Name="txtNom" Width="100" Margin="5,0"/>
                            <TextBox x:Name="txtPrenom" Width="100" Margin="5,0"/>
                            <TextBox x:Name="txtEmail" Width="150" Margin="5,0"/>
                            <Button Content="Ajouter" Click="cmdAjouter_Click" Width="80" Background="#1E1E1E" Foreground="White"/>
                            <Button Content="Supprimer" Click="cmdSupprimer_Click" Width="80" Margin="10,0" Background="#EA4335" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="panAlertes" Visibility="Collapsed" Margin="25">
                    <StackPanel>
                        <Button Content="🚀 Lancer l'alerte SMTP" Click="cmdLancerAlerte_Click" Height="40" Background="#EA4335" Foreground="White"/>
                        <TextBlock x:Name="lblAlerteInfo" Text="Statut : En attente..." Foreground="White" Margin="0,10"/>
                        <ListBox x:Name="lstHistoriqueAlertes" Height="250" Background="White"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>