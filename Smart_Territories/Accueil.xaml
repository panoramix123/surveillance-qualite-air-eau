<Page x:Class="Smart_Territories.Accueil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Smart_Territories"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Accueil">

    <Grid Background="Gray">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal">
                <Image Width="175" 
                       Stretch="Uniform"
                       Source="Images/Smart_territories_logo.png"/>
                
                <TextBlock Text="SafeBreath" 
                           Foreground="Black" 
                           FontSize="20" 
                           FontWeight="Medium" 
                           VerticalAlignment="Center" 
                           FontFamily="Fonts/#Dosis"/>
            </StackPanel>

            <TextBlock Text="Bienvenue" 
                       Foreground="Black" 
                       FontSize="25" 
                       FontWeight="Medium" 
                       FontFamily="Fonts/#Dosis"/>
            
            <TextBlock Text="Sur SafeBreath" 
                       Foreground="Black" 
                       FontSize="25" 
                       FontWeight="Medium" 
                       FontFamily="Fonts/#Dosis"/>
            
            <TextBlock Text="IQA / IQE" 
                       Foreground="Black" 
                       FontSize="25" 
                       FontWeight="Medium" 
                       FontFamily="Fonts/#Dosis"/>

            <TextBlock Text="Vous trouverez sur cette application tout ce qui concerne la pollution de l'air et de l'eau : le nom de tous les polluants, des infos sur le pollen, des graphiques, les différents lieux."
                       Foreground="Black" 
                       FontSize="12" 
                       FontWeight="Medium" 
                       FontFamily="Fonts/#Dosis" 
                       TextWrapping="Wrap" 
                       Margin="0,10,0,20"/>
        </StackPanel>
    </Grid>
</Page>