<Page x:Class="Smart_Territories.Connexion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Smart_Territories"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Connexion">

    <Grid Background="Gray">
        <Border Width="300" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Background="DarkGray" 
                CornerRadius="8" 
                Padding="30">

            <StackPanel>
                <TextBlock Text="Se connecter" 
                           Foreground="Black" 
                           FontSize="24" 
                           FontWeight="Medium" 
                           FontFamily="Fonts/#Dosis" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <TextBlock Text="Identifiant" Foreground="Black" FontFamily="Fonts/#Dosis" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUsername" 
                         Height="30" 
                         Padding="5" 
                         Margin="0,0,0,15" 
                         FontFamily="Fonts/#Dosis" 
                         BorderThickness="0"/>

                <TextBlock Text="Mot de passe" Foreground="Black" FontFamily="Fonts/#Dosis" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" 
                             Height="30" 
                             Padding="5" 
                             Margin="0,0,0,25" 
                             FontFamily="Fonts/#Dosis" 
                             BorderThickness="0"/>

                <TextBlock x:Name="ErrorText" 
                           Foreground="DarkRed" 
                           FontSize="12" 
                           FontFamily="Fonts/#Dosis" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10" 
                           Visibility="Collapsed" 
                           TextWrapping="Wrap"/>

                <Button x:Name="BtnLogin" 
                        Content="Se connecter" 
                        IsDefault="True" 
                        Height="35" 
                        Click="BtnLogin_Click" 
                        Background="#333333" 
                        Foreground="White" 
                        FontFamily="Fonts/#Dosis" 
                        FontWeight="Medium" 
                        Cursor="Hand" 
                        Margin="0,0,0,10"/>

                <Button x:Name="BtnRegister" 
                        Content="Créer un compte" 
                        Height="35" 
                        Click="BtnRegister_Click" 
                        Background="DarkGray" 
                        Foreground="Black" 
                        FontFamily="Fonts/#Dosis" 
                        FontWeight="Medium" 
                        Cursor="Hand" 
                        BorderThickness="1" 
                        BorderBrush="#333333"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>