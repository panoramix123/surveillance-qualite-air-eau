<Page x:Class="Smart_Territories.Graphiques"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Graphiques">

    <Grid Background="Gray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="DarkGray" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock Text="Réglages" FontSize="20" FontWeight="Bold" FontFamily="Fonts/#Dosis" Margin="0,0,0,20"/>

                <TextBlock Text="Temps entre mesures :" FontWeight="Bold" FontFamily="Fonts/#Dosis" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="SliderFrequency" 
                            Minimum="1" Maximum="60" 
                            Value="5" TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            Width="130" 
                            ValueChanged="SliderFrequency_ValueChanged"/>

                    <TextBlock x:Name="TxtSliderValue" Text="24h" FontFamily="Fonts/#Dosis" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Afficher :" FontWeight="Bold" FontFamily="Fonts/#Dosis" Margin="0,0,0,10"/>
                <ItemsControl x:Name="PollutantSelector">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" 
                                      IsChecked="{Binding IsSelected}" 
                                      Checked="CheckBox_FilterChanged" 
                                      Unchecked="CheckBox_FilterChanged"
                                      FontFamily="Fonts/#Dosis" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock x:Name="TxtTitle" Text="Analyses détaillées" 
                           FontFamily="Fonts/#Dosis" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="10,0,0,15"/>

                <ItemsControl x:Name="ChartsContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="350" Height="220" Background="DarkGray" CornerRadius="8" Padding="15" Margin="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Title}" FontFamily="Fonts/#Dosis" FontSize="16" FontWeight="Bold" Foreground="Black"/>

                                    <Canvas Grid.Row="1" Width="300" Height="130" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Polyline Points="{Binding LinePoints}" Stroke="#333333" StrokeThickness="3" StrokeLineJoin="Round"/>
                                        <ItemsControl ItemsSource="{Binding Points}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <TextBlock Text="{Binding Value}" FontSize="9" FontFamily="Fonts/#Dosis" 
                                                                   Canvas.Left="{Binding TextX}" Canvas.Top="{Binding TextY}"/>
                                                        <Ellipse Width="6" Height="6" Fill="White" Stroke="#333333" 
                                                                 Canvas.Left="{Binding PointX}" Canvas.Top="{Binding PointY}"/>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding DisplayPoints}" Width="300" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Height="15"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas>
                                                    <TextBlock Text="{Binding AxisLabel}" FontSize="9" FontFamily="Fonts/#Dosis" 
                                                               Foreground="#555555" FontWeight="Medium" 
                                                               Canvas.Left="{Binding AxisX}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>