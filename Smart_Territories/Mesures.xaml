<Page x:Class="Smart_Territories.Mesures"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Smart_Territories"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Mesures">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,10,15,15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="145"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Fonts/#Dosis"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Fonts/#Dosis"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" x:Name="border">
                            <Image Source="/Images/Info-bulle.png" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Gray">

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <TextBlock Text="Mesures dans l'air" FontFamily="Fonts/#Dosis" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="10,0,0,15"/>
                <WrapPanel Orientation="Horizontal">

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PM2.5" Style="{StaticResource CardTitleStyle}" Grid.Column="0"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="PM25"/>
                            </Grid>
                            <TextBlock Text="Particules fines d'un diamètre inférieur à 2,5 µm. Elles pénètrent profondément dans les poumons." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PM10" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="PM10"/>
                            </Grid>
                            <TextBlock Text="Particules en suspension d'un diamètre inférieur à 10 µm. Elles irritent principalement les voies supérieures." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ozone (O₃)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="O3"/>
                            </Grid>
                            <TextBlock Text="Gaz irritant formé par des réactions photochimiques. Hautement toxique pour le système respiratoire." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dioxyde d'azote (NO₂)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="NO2"/>
                            </Grid>
                            <TextBlock Text="Gaz émis par les processus de combustion (trafic routier). Il altère la fonction pulmonaire." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dioxyde de soufre (SO₂)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="SO2"/>
                            </Grid>
                            <TextBlock Text="Gaz issu de la combustion d'énergies fossiles. Il cause des problèmes respiratoires et pluies acides." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dioxyde de carbone (CO₂)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="CO2"/>
                            </Grid>
                            <TextBlock Text="Indicateur clé du niveau de confinement en espace clos. Des niveaux élevés nuisent à la concentration." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pression atmos. (hPa)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="HPA"/>
                            </Grid>
                            <TextBlock Text="Force exercée par l'air. Les hautes pressions plaquent souvent les polluants au sol." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Température (°C)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="TEMP"/>
                            </Grid>
                            <TextBlock Text="Les fortes chaleurs accélèrent la formation de certains polluants comme l'ozone." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Taux d'humidité (%)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="HUMID"/>
                            </Grid>
                            <TextBlock Text="Quantité de vapeur d'eau dans l'air. Elle peut influencer la suspension des particules." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </WrapPanel>

                <TextBlock Text="Mesures dans l'eau" FontFamily="Fonts/#Dosis" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="10,30,0,15"/>
                <WrapPanel Orientation="Horizontal">

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dioxygène gazeux (O₂)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="O2"/>
                            </Grid>
                            <TextBlock Text="Oxygène dissous dans l'eau, vital pour la faune aquatique. Une baisse indique souvent une pollution." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Turbidité (UTN)" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="UTN"/>
                            </Grid>
                            <TextBlock Text="Mesure le trouble de l'eau dû aux matières en suspension. Bloque la lumière nécessaire aux plantes." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="pH" Style="{StaticResource CardTitleStyle}"/>
                                <Button Style="{StaticResource InfoButtonStyle}" Grid.Column="1" Click="InfoButton_Click" Tag="PH"/>
                            </Grid>
                            <TextBlock Text="Mesure l'acidité ou la basicité (0 à 14). Un changement brusque est mortel pour les écosystèmes." Style="{StaticResource CardTextStyle}" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <Popup x:Name="InfoPopup" 
               StaysOpen="False" 
               Placement="Bottom" 
               AllowsTransparency="True" 
               PopupAnimation="Fade">

            <Border Background="#333333" CornerRadius="8" Padding="15" Margin="5" Width="300">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="2"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="PopupTitleText" 
                               Text="Titre" 
                               FontFamily="Fonts/#Dosis" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="PopupDetailText" 
                               Text="Détails" 
                               FontFamily="Fonts/#Dosis" 
                               FontSize="11" 
                               FontWeight="Medium" 
                               Foreground="LightGray" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Page>