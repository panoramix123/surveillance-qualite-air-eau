<Page x:Class="Smart_Territories.Pollens"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Pollens"
      TextElement.FontFamily="Dosis"
      Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="*"/>
            <!-- Carte -->
        </Grid.RowDefinitions>

        <!-- Titre esthétique -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Carte des Pollens" Foreground="Black" FontSize="28" FontWeight="Bold" FontFamily="Fonts/#Dosis"/>
            <Border Height="3" Width="60" Background="#00BFFF" HorizontalAlignment="Left" Margin="2,5,0,0" CornerRadius="1.5"/>
        </StackPanel>

        <!-- Conteneur avec angles arrondis et ombre -->
        <Border Grid.Row="1" CornerRadius="15" Background="#2C2C2C" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>

            <!-- On ne met pas de Source ici pour éviter l'erreur d'entité XML -->
            <wv2:WebView2 x:Name="PollenWebView" />
        </Border>
    </Grid>
</Page>