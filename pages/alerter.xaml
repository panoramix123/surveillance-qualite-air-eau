<Page x:Class="Wpf_localiser.pages.alerter"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Alerter"
      TextElement.FontFamily="Fonts/#Dosis"
      Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Gestion des Alertes" Foreground="Black" FontSize="28" FontWeight="Bold"/>
            <Border Height="3" Width="60" Background="#00BFFF" HorizontalAlignment="Left" Margin="2,5,0,0" CornerRadius="1.5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="15" Background="#2C2C2C" Margin="0,0,20,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Nouvel Abonné" Foreground="White" FontSize="20" FontWeight="Medium" Margin="0,0,0,20"/>
                    <TextBlock Text="Nom :" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNom" Height="30" Background="#444444" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Email :" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEmail" Height="30" Background="#444444" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Commune :" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCommune" Height="30" Background="#444444" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,25"/>
                    <Button Content="Ajouter l'abonné" Click="BtnAjouter_Click" Height="35" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="15" Background="#2C2C2C" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Liste des abonnés" Foreground="White" FontSize="20" Margin="0,0,0,15"/>

                    <ListBox x:Name="LstAbonnes" Grid.Row="1" Background="#222222" BorderThickness="0" Foreground="White" Margin="0,0,0,15" Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Nom}" FontWeight="Bold" Foreground="#00BFFF"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Button Content="Diffuser l'alerte SMTP" Click="BtnDiffuserAlerte_Click" Height="40" Background="DarkRed" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="LblStatus" Text="En attente..." Foreground="#888888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>