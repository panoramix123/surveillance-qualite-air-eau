<Page x:Class="Wpf_localiser.pages.cartes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
      Title="Cartes"
      TextElement.FontFamily="Fonts/#Dosis"
      Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Cartographie en temps réel" Foreground="Black" FontSize="28" FontWeight="Bold"/>
            <Border Height="3" Width="60" Background="#00BFFF" HorizontalAlignment="Left" Margin="2,5,0,0" CornerRadius="1.5"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtRecherche" Grid.Column="0" Height="35" FontSize="16" Padding="10,0" VerticalContentAlignment="Center" Background="#444444" Foreground="White" BorderThickness="0" Margin="0,0,15,0">
                <TextBox.ToolTip>Tapez le nom d'une ville (ex: Paris, Nantes...)</TextBox.ToolTip>
            </TextBox>

            <Button Grid.Column="1" Content="Rechercher" Click="BtnRechercher_Click" Height="35" Width="130" Background="#00BFFF" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="2" CornerRadius="15" Background="#2C2C2C" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>

            <Grid Background="#222222">
                <gmap:GMapControl x:Name="MainMap" 
                                  MinZoom="2" 
                                  MaxZoom="22" 
                                  Zoom="13" 
                                  MouseWheelZoomType="MousePositionAndCenter" 
                                  CanDragMap="True" />
            </Grid>
        </Border>
    </Grid>
</Page>